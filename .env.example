# --- Database (Postgres) ---
# Accounts, progress, and the custom-calculator unlock are stored here.
# Leave unset in local dev to run with accounts disabled (site degrades gracefully).
DATABASE_URL=

# --- Auth ---
# Signs session JWTs. On Render's Blueprint this is auto-generated for you.
JWT_SECRET=change-me-in-your-local-env

# --- Admin access (comma-separated emails that get the custom calculator
# for free and can never be charged for it) ---
ADMIN_EMAILS=

# --- Stripe ($5 one-time custom calculator unlock, optional in local dev) ---
# Get a test-mode key at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

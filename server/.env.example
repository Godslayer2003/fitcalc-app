# --- Database (Postgres, e.g. a Neon project) ---
DATABASE_URL=

# --- Auth ---
JWT_SECRET=change-me-in-your-local-env

# --- Admin access (comma-separated emails that get the custom calculator
# for free and can never be charged for it) ---
ADMIN_EMAILS=

# --- Stripe ($5 one-time custom calculator unlock) ---
STRIPE_SECRET_KEY=

# --- The web app's origin, for CORS and Stripe checkout redirects ---
# e.g. https://fitcalc-app-omega.vercel.app
WEB_ORIGIN=http://localhost:3000
